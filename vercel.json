{
  "version": 2,
  "builds": [
    {
      "src": "api/app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["templates/**", "*.pkl"],
        "excludeFiles": ["*.ipynb", ".git/**", "__pycache__/**", ".ipynb_checkpoints/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/app.py"
    }
  ]
}